# Published as the offering repo's .gitignore (scripts/publish.sh).
# Build output: several GB, all regenerable by `make -C env images`.
env/dist/
env/cache/
env/src/
*.log
.DS_Store
# Per-workspace VM state (qemu pid, console log, ssh keypair)
.vm/
# Mutation kernel images arrive as release assets, not as repo content
bzImage-*
# A workspace copied from agent-starter/ into this checkout is local scratch.
# publish.sh commits with `git add -A`, so without this an instructor (or a
# student) trying the starter here would push their workspace to everyone.
# Student work lives in their own repo under students/, not in this tree.
my-workspace/
